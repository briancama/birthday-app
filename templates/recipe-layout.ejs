<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Friends food competition recipes' %>">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>RecipeClash</title>
  <link rel="stylesheet" href="/styles.css">
  <!--
    NOTE: The Google Fonts import in styles.css is a best-effort for Trebuchet MS
    (which is a system font on Windows but not universally installed). The CSS font
    stack already falls back to Arial/sans-serif which preserves the 90s feel.
    For full control, consider self-hosting a web-safe Trebuchet clone.
  -->
</head>
<body>

  <!-- ═══════════════════════════════════════════════════
       SITE HEADER
  ════════════════════════════════════════════════════ -->
  <header class="site-header">
    <div class="site-wrapper">
      <div class="site-header__inner">
        <a href="/" class="site-header__logo">
          Recipe<span>Clash</span>
          <div class="site-header__tagline">Where friends settle it in the kitchen</div>
        </a>
        <div class="site-header__search">
          <form action="/search" method="GET" role="search">
            <label for="site-search" class="visually-hidden">Search recipes</label>
            <div class="search-bar">
              <input
                type="search"
                id="site-search"
                name="q"
                placeholder="Search recipes…"
                value="<%= typeof query !== 'undefined' ? query : '' %>"
                autocomplete="off"
              >
              <button type="submit">Go!</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════════
       PRIMARY NAV
  ════════════════════════════════════════════════════ -->
  <nav class="site-nav" aria-label="Main navigation">
    <div class="site-wrapper">
      <ul class="site-nav__list" role="list">
        <li class="site-nav__item"><a href="/"              aria-current="<%= page === 'home'        ? 'page' : 'false' %>">Home</a></li>
        <li class="site-nav__item"><a href="/recipes"       aria-current="<%= page === 'recipes'     ? 'page' : 'false' %>">All Recipes</a></li>
        <li class="site-nav__item"><a href="/competitions"  aria-current="<%= page === 'competitions'? 'page' : 'false' %>">Competitions</a></li>
        <li class="site-nav__item"><a href="/categories"    aria-current="<%= page === 'categories'  ? 'page' : 'false' %>">Categories</a></li>
        <li class="site-nav__item"><a href="/submit"        aria-current="<%= page === 'submit'      ? 'page' : 'false' %>">Submit Recipe</a></li>
        <li class="site-nav__item"><a href="/about"         aria-current="<%= page === 'about'       ? 'page' : 'false' %>">About</a></li>
      </ul>
    </div>
  </nav>

  <!-- ═══════════════════════════════════════════════════
       PAGE BODY  (templates inject here)
  ════════════════════════════════════════════════════ -->
  <main id="main-content">
    <%- body %>
  </main>

  <!-- ═══════════════════════════════════════════════════
       SITE FOOTER
  ════════════════════════════════════════════════════ -->
  <footer class="site-footer">
    <div class="site-wrapper">
      <nav class="site-footer__links" aria-label="Footer navigation">
        <a href="/">Home</a>
        <a href="/recipes">Recipes</a>
        <a href="/competitions">Competitions</a>
        <a href="/submit">Submit</a>
        <a href="/about">About</a>
      </nav>
      <hr>
      <p>
        &copy; <%= new Date().getFullYear() %> RecipeClash &mdash;
        A private recipe collection for friends and competitors.
        <br>
        <small>Built with EJS &amp; Supabase &bull; Designed in the spirit of <em>AllRecipes.com, circa 1998</em></small>
      </p>
    </div>
  </footer>

</body>
</html>
