<% const metaDescription = `A month of haunted jaunts. Set a daily step goal, log your steps every day in October, and see how you stack up on the leaderboard.`; %>
<meta name="description" content="<%= metaDescription %>" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="BriSpace" />
<meta property="og:title" content="Walktober <%= year %>" />
<meta property="og:description" content="<%= metaDescription %>" />
<%# Crawlers need an absolute image URL. %>
<meta property="og:image" content="https://birthday.briancama.com/images/walktober_social.jpg" />
<meta property="og:image:width" content="2121" />
<meta property="og:image:height" content="1063" />
<meta property="og:image:alt" content="Walktober: a month of haunted jaunts" />
<meta name="twitter:card" content="summary_large_image" />
