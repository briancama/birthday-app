<!doctype html>
<html lang="en">
  <head>
    <%- include('partials/head', { pageTitle: 'My Entry' }) %>
    <%- include(kit.headExtra) %>
    <link
      rel="preload"
      as="script"
      href="https://www.gstatic.com/firebasejs/10.7.2/firebase-app-compat.js"
    />
    <link
      rel="preload"
      as="script"
      href="https://www.gstatic.com/firebasejs/10.7.2/firebase-auth-compat.js"
    />
  </head>

  <body class="kit<%= kit.key ? ' theme-' + kit.key : '' %>" data-page="enter">
    <%- include(kit.header) %> <%- include('partials/admin-bar') %>

    <main class="kit-main">
      <div class="kit-wrap">
        <div class="kit-page-head">
          <h1 class="kit-title">My Entry</h1>
          <p class="kit-status">
            <% if (state === 'hidden') { %>Only you can see this. Once judging starts, judges see
            your dish card. The full recipe goes public after the event.<% } else if (state ===
            'judging') { %>Judges can see your dish card now. The full recipe goes public after the
            event.<% } else { %>Your recipe is public. You can keep editing it.<% } %>
          </p>
        </div>
        <div id="enterRoot" data-landing="<%= links.landing || '' %>"></div>
      </div>
    </main>

    <%- include(kit.footer) %>
    <div id="kitModalRoot"></div>

    <script type="application/json" id="kitData">
      <%- payloadJson %>
    </script>
    <script type="module">
      import { EnterPage } from "/js/pages/comp-kit-enter.js";

      new EnterPage().init();
    </script>
  </body>
</html>
