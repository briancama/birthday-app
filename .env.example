# Copy to .env and fill in values from the DEV Supabase/Firebase projects.
# Production values live in the systemd EnvironmentFile on the droplet (see docs/DEPLOYMENT.md).

# --- Required ---
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_SERVICE_ROLE=your-dev-service-role-key
COOKIE_SECRET=any-string-in-dev

# --- Firebase admin (only needed to test the real OTP login flow) ---
# Either a JSON string:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Or a path to the JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-dev-firebase-project

# --- Web Push (only needed to test notifications; npx web-push generate-vapid-keys) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=you@example.com

# --- Dev conveniences (see docs/GETTING-STARTED.md) ---
# Default identity for dev auto-login (uuid or username):
# DEV_LOCAL_USER_ID=brianc
# Disable auto-login to test the real login flow:
# DEV_DISABLE_AUTOLOGIN=1
# Simulate production cookie behavior locally:
# DEV_SIMULATE_LIVE=1

# --- db:pull (scripts/db-pull.js): copy prod content into the dev project ---
# PROD_SUPABASE_URL=https://your-prod-project.supabase.co
# PROD_SUPABASE_SERVICE_ROLE=your-prod-service-role-key

# PORT=8000
